# ═══ TeamCherry — biến môi trường ═══
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# --- Database ---
DATABASE_URL="postgresql://teamcherry:teamcherry_dev_password@localhost:5435/teamcherry?schema=public"

# --- Auth.js (NextAuth v5) ---
# Sinh khóa: openssl rand -base64 32
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-byte"
AUTH_URL="http://localhost:3005"
AUTH_TRUST_HOST=true

# Địa chỉ gốc dùng để tạo link phiếu thu gửi phụ huynh
APP_URL="http://localhost:3005"

# --- MinIO (ảnh đề, bài nộp, ghi âm nhận xét) ---
MINIO_ENDPOINT="localhost"
MINIO_PORT=9200
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="teamcherry"
MINIO_SECRET_KEY="teamcherry_dev_password"
MINIO_BUCKET="teamcherry-files"

# --- Khác ---
TZ="Asia/Ho_Chi_Minh"

# Tài khoản cô giáo do seed tạo (chỉ dùng ở môi trường dev)
SEED_TEACHER_EMAIL="co.ha@teamcherry.vn"
SEED_DEFAULT_PASSWORD="Cherry@2026"
